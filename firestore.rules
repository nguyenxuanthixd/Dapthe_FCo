rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin: đăng nhập Google bằng email trong danh sách này được xem dây của mọi tài khoản
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['nguyenxuanthixd@gmail.com'];
    }
    match /users/{uid} {
      // Mỗi tài khoản đọc/ghi dữ liệu của chính mình
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Admin chỉ được xem, không sửa
      allow read: if isAdmin();
    }
  }
}
